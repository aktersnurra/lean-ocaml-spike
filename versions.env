# Pinned toolchain for the Lean -> Peregrine -> OCaml extraction spike.
# Every value here is an input to Gate 1; change one only on purpose and note it in README.md.

# Lean frontend (Lean -> lambda-box). Its own lean-toolchain is v4.22.0, so the
# domain project MUST build with that Lean version (peregrine-tool itself pins v4.34.1,
# but that is for its Lean *backend*, which this spike does not use).
LEAN_TOOLCHAIN=leanprover/lean4:v4.22.0
L2L_REPO=https://github.com/peregrine-project/lean-to-lambdabox
L2L_REV=58701f8b77111012b4b43af16c241f4ac7c55ab1

# Peregrine middle-end + OCaml (Malfunction) backend.
PEREGRINE_REPO=https://github.com/peregrine-project/peregrine-tool
PEREGRINE_REV=2984751766180afcbc8f0e45eafafc59810b5f7c

# Malfunction compiler (.mlf -> .cmx).
MALFUNCTION_REPO=https://github.com/stedolan/malfunction
MALFUNCTION_REV=1682ecd4efc5ebcfce41adcf0d40b23233586ed8

# OCaml: Peregrine's dev docs use 4.14.2 with flambda.
OCAML_VARIANT=ocaml-variants.4.14.2+options
OCAML_OPTIONS=ocaml-option-flambda

# opam switch names used by scripts/.
PEREGRINE_SWITCH=spike-peregrine
MALFUNCTION_SWITCH=spike-malfunction
